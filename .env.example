# =====================================================================
# FinalBot - Discord Bot Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# =====================================================================

# Discord Bot Token
BOT_TOKEN=your_bot_token_here

# Command Prefix & Timezone
COMMAND_PREFIX=z
TIMEZONE=Asia/Dhaka

# Discord Server (Guild) & Role IDs
GUILD=your_guild_id_here
ROLE_USER=your_user_role_id_here
ROLE_ADMIN=your_admin_role_id_here

# Channel IDs
CHANNEL_INFO=your_stat_channel_id_here
CHANNEL_LIFELESS=your_lifeless_channel_id_here
DELETE_LOG=your_delete_log_channel_id_here
JOIN_LOG=your_join_log_channel_id_here
RESET_INFO=your_reset_info_channel_id_here
YAP_CHAT=your_chat_channel_id_here

# Author / Superuser IDs (comma-separated Discord User IDs)
AUTHOR=your_discord_id_1,your_discord_id_2
TARGET_ID=your_protected_user_id_here

# AI Service Configuration (OpenRouter)
AI_TOKEN=sk-or-v1-your_openrouter_token_here
AI_BASE_URL=https://openrouter.ai/api/v1
AI_CHANNEL=your_ai_channel_id_here
AI_MODEL=~openai/gpt-sol-latest
AI_SITE_URL=
AI_SITE_NAME=FinalBot

# Database Configuration (MySQL)
DB_HOST=your_mysql_host_here
DB_USER=your_mysql_user_here
DB_PASSWORD=your_mysql_password_here
DB_PORT=3306
DB_NAME=your_database_name_here
